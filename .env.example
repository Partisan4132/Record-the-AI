# Discord Developer Portal → your app → Bot → Token
DISCORD_TOKEN=

# Discord Developer Portal → your app → General Information → Application ID
DISCORD_CLIENT_ID=

# console.groq.com/keys — free, no credit card required
GROQ_API_KEY=

# Right-click the support channel in Discord (Developer Mode on) → Copy Channel ID
SUPPORT_CHANNEL_ID=

# Optional. Defaults to Llama 3.3 70B (free tier) if omitted. Other free options on
# Groq: "openai/gpt-oss-120b", "llama-3.1-8b-instant" (faster, lower quality).
GROQ_MODEL=llama-3.3-70b-versatile
